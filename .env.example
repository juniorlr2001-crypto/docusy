# === 100% COSTO CERO ($0) — Claves DEDICADAS solo para este canal ===
# Usa cuentas propias / separadas para NO tocar cuotas ni recursos de tu otro proyecto.
DOCU_GEMINI_API_KEY=
DOCU_CLOUDFLARE_ACCOUNT_ID=
DOCU_CLOUDFLARE_API_TOKEN=
DOCU_PEXELS_API_KEY=
DOCU_PIXABAY_API_KEY=

# Máximo de imágenes IA (Cloudflare FLUX.1 Schnell) por documental (14 imgs ≈ 1,540 neuronas; cuota gratis = 10,000/día)
DOCU_MAX_AI_IMAGES=14

# Bandas panorámicas cinematográficas 2.05:1 (true/false)
DOCU_CINEMA_LETTERBOX=true

# === Canal de YouTube INDEPENDIENTE (Opcional — solo si luego quieres subir automático por CLI) ===
DOCU_YOUTUBE_CLIENT_ID=
DOCU_YOUTUBE_CLIENT_SECRET=
DOCU_YOUTUBE_REFRESH_TOKEN=
DOCU_YOUTUBE_PRIVACY=unlisted

# === Nombre del canal documental ===
DOCU_CHANNEL_NAME=docusy
